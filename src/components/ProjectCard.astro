---
const { title, year, tags = [], description, badge, id, icon, handtag, featured } = Astro.props;
---

<a href={`/work/${id}`} class="project-card-wrapper">
  <div class={`card ${featured ? 'featured' : ''}`}>
    <div class="card-tape"></div>
    <div class="card-img">
      {badge && <span class="badge">{badge}</span>}
      <span class="card-img-icon">{icon}</span>
      {handtag && <span class="card-handtag">{handtag}</span>}
    </div>
    <div class="card-body">
      <div class="card-meta">
        <span class="card-year">{year}</span>
        {tags.map((tag: string) => <span class="card-tag">{tag}</span>)}
      </div>
      <h2 class="card-title">{title}</h2>
      <p class="card-desc">{description}</p>
      <div class="card-footer">
        <span class="card-link">OPEN BRIEF →</span>
        <span class="card-id">{id}</span>
      </div>
    </div>
  </div>
</a>

<style>
  /* Ensure the link doesn't look like a standard blue hyperlink */
  .project-card-wrapper {
    text-decoration: none;
    color: inherit;
    display: block;
    transition: transform 0.2s ease;
  }

  /* Add a slight lift effect when hovering over the link */
  .project-card-wrapper:hover {
    transform: translateY(-4px);
  }

  /* You can also trigger inner card changes on hover */
  .project-card-wrapper:hover .card {
    border-color: #1B3D6E;
  }

  .project-card-wrapper:hover .card-link {
    color: #1B3D6E;
    text-decoration: underline;
  }
</style>
