---
const { 
  title, 
  year, 
  tags = [], 
  description, 
  badge, 
  id, 
  icon, 
  handtag, 
  featured, 
  coverImage 
} = Astro.props;
---

<a href={`/work/${id}`} class="project-card-wrapper">
  <div class={`card ${featured ? 'featured' : ''}`}>
    <div class="card-img-container">
      {coverImage ? (
        <img 
          src={coverImage} 
          alt={title} 
          class="main-photo"
          loading="lazy"
        />
      ) : (
        <div class="photo-placeholder">
          <span class="placeholder-icon">{icon || '📁'}</span>
        </div>
      )}
      
      {badge && <span class="badge">{badge}</span>}
    </div>

    <div class="card-body">
      <div class="card-meta">
        <span class="card-year">{year}</span>
        <div class="tag-list">
          {tags.slice(0, 3).map((tag: string) => (
            <span class="card-tag">{tag}</span>
          ))}
        </div>
      </div>

      <h2 class="card-title">{title}</h2>
      <p class="card-desc">{description}</p>

      <div class="card-footer">
        <span class="card-link">View project →</span>
      </div>
    </div>
  </div>
</a>

<style>
  .project-card-wrapper {
    text-decoration: none;
    color: inherit;
    display: block;
    transition: transform 0.2s ease;
  }

  .project-card-wrapper:hover {
    transform: translateY(-3px);
  }

  .card {
    background: #fff;
    border: 1px solid #E5E3DE;
    border-radius: 10px;
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .project-card-wrapper:hover .card {
    box-shadow: 0 8px 24px -8px rgba(0,0,0,0.15);
    border-color: #d8d5cd;
  }

  .card.featured {
    border-color: #2E5943;
  }

  .card-img-container {
    position: relative;
    width: 100%;
    height: 190px;
    background: #F3F2EE;
    overflow: hidden;
  }

  .main-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .project-card-wrapper:hover .main-photo {
    transform: scale(1.03);
  }

  .photo-placeholder {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .placeholder-icon { font-size: 2.5rem; opacity: 0.35; }

  .card-body {
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.7rem;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .card-year {
    font-size: 0.75rem;
    font-weight: 500;
    color: #6B6B6B;
  }

  .tag-list { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .card-tag {
    font-size: 0.68rem;
    color: #2E5943;
    background: rgba(46,89,67,0.08);
    padding: 0.15em 0.55em;
    border-radius: 4px;
  }

  .card-title {
    font-size: 1.15rem;
    font-weight: 600;
    margin: 0 0 0.5rem 0;
    line-height: 1.25;
    color: #1A1A1A;
    letter-spacing: -0.01em;
  }

  .card-desc {
    font-size: 0.88rem;
    line-height: 1.55;
    color: #6B6B6B;
    margin-bottom: 1.25rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    margin-top: auto;
    padding-top: 0.9rem;
    border-top: 1px solid #EFEDE8;
  }

  .card-link {
    font-size: 0.82rem;
    font-weight: 500;
    color: #2E5943;
  }

  .badge {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 5;
    background: #1A1A1A;
    color: #fff;
    padding: 0.2em 0.6em;
    font-size: 0.68rem;
    font-weight: 500;
    border-radius: 4px;
  }
</style>
