---
// We removed the Astro Image import because images are now in /public
const { 
  title, 
  year, 
  tags = [], 
  description, 
  badge, 
  id, 
  icon, 
  handtag, 
  featured, 
  coverImage 
} = Astro.props;
---

<a href={`/work/${id}`} class="project-card-wrapper">
  <div class={`card ${featured ? 'featured' : ''}`}>
    <div class="card-tape"></div>

    <div class="card-img-container">
      {coverImage ? (
        <img 
          src={coverImage} 
          alt={title} 
          class="main-photo"
          loading="lazy"
        />
      ) : (
        <div class="photo-placeholder">
          <span class="placeholder-icon">{icon || '📁'}</span>
        </div>
      )}
      
      {badge && <span class="badge">{badge}</span>}
      {handtag && <span class="card-handtag">{handtag}</span>}
    </div>

    <div class="card-body">
      <div class="card-meta">
        <span class="card-year">{year}</span>
        <div class="tag-list">
          {tags.slice(0, 3).map((tag: string) => (
            <span class="card-tag">#{tag}</span>
          ))}
        </div>
      </div>

      <h2 class="card-title">{title}</h2>
      <p class="card-desc">{description}</p>

      <div class="card-footer">
        <span class="card-link">OPEN_BRIEF →</span>
        <span class="card-id">REF_{id.substring(0, 8).toUpperCase()}</span>
      </div>
    </div>
  </div>
</a>

<style>
  .project-card-wrapper {
    text-decoration: none;
    color: inherit;
    display: block;
    transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .project-card-wrapper:hover {
    transform: translateY(-5px);
  }

  .card {
    background: white;
    border: 1px solid #e2e8f0;
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
  }

  .card.featured {
    border-top: 4px solid #f97316;
  }

  .card-tape {
    position: absolute;
    top: -10px;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 25px;
    background: rgba(27, 61, 110, 0.1);
    backdrop-filter: blur(2px);
    z-index: 10;
  }

  .card-img-container {
    position: relative;
    width: 100%;
    height: 200px;
    background: #f1f5f9;
    overflow: hidden;
    border-bottom: 1px solid #e2e8f0;
  }

  .main-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 0.5s ease;
  }

  .project-card-wrapper:hover .main-photo {
    scale: 1.05;
  }

  .photo-placeholder {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: repeating-linear-gradient(45deg, #f8fafc, #f8fafc 10px, #f1f5f9 10px, #f1f5f9 20px);
  }

  .placeholder-icon { font-size: 3rem; opacity: 0.3; }

  /* Content Spacing */
  .card-body {
    padding: 1.5rem; 
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .card-year {
    font-family: monospace;
    font-size: 0.75rem;
    font-weight: bold;
    color: #1B3D6E;
    background: rgba(27, 61, 110, 0.05);
    padding: 2px 6px;
  }

  .tag-list { display: flex; gap: 0.5rem; }
  .card-tag { font-family: monospace; font-size: 0.65rem; color: #64748b; }

  .card-title {
    font-size: 1.25rem;
    font-weight: 800;
    margin: 0 0 0.75rem 0;
    line-height: 1.2;
    color: #0f172a;
  }

  .card-desc {
    font-size: 0.9rem;
    line-height: 1.5;
    color: #475569;
    margin-bottom: 1.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px dashed #e2e8f0;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .card-link {
    font-family: monospace;
    font-size: 0.75rem;
    font-weight: bold;
    color: #1B3D6E;
  }

  .card-id {
    font-family: monospace;
    font-size: 0.65rem;
    color: #cbd5e1;
  }

  .badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: #1B3D6E;
    color: white;
    padding: 2px 8px;
    font-family: monospace;
    font-size: 0.7rem;
    font-weight: bold;
    z-index: 5;
  }

  .card-handtag {
    position: absolute;
    bottom: 0.5rem;
    left: 0.5rem;
    background: #fef08a;
    color: #854d0e;
    padding: 2px 8px;
    font-family: 'Comic Sans MS', cursive;
    font-size: 0.7rem;
    transform: rotate(-2deg);
    box-shadow: 2px 2px 5px rgba(0,0,0,0.1);
  }
</style>
