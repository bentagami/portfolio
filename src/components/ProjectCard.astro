---
const { 
  title, 
  year, 
  tags = [], 
  description, 
  badge, 
  id, 
  icon, 
  handtag, 
  featured, 
  coverImage 
} = Astro.props;

// Stable "random" tilt per project (same every build), between -1.8 and +1.8 degrees.
let hash = 0;
for (const ch of String(id)) hash = (hash * 31 + ch.charCodeAt(0)) >>> 0;
const tilt = (((hash % 361) / 360) * 3.6 - 1.8).toFixed(2);
---

<a href={`/work/${id}`} class="project-card-wrapper" style={`--tilt: ${tilt}deg`}>
  <div class={`card ${featured ? 'featured' : ''}`}>
    <div class="card-img-container">
      {coverImage ? (
        <img 
          src={coverImage} 
          alt={title} 
          class="main-photo"
          loading="lazy"
        />
      ) : (
        <div class="photo-placeholder">
          <span class="placeholder-icon">{icon || '📁'}</span>
        </div>
      )}
      
      {badge && <span class="badge">{badge}</span>}
    </div>

    <div class="card-body">
      <div class="card-meta">
        <span class="card-year">{year}</span>
        <div class="tag-list">
          {tags.slice(0, 3).map((tag: string) => (
            <span class="card-tag">{tag}</span>
          ))}
        </div>
      </div>

      <h2 class="card-title">{title}</h2>
      <p class="card-desc">{description}</p>

      <div class="card-footer">
        <span class="card-link">View project →</span>
      </div>
    </div>
  </div>
</a>

<style>
  .project-card-wrapper {
    text-decoration: none;
    color: inherit;
    display: block;
    transform: rotate(var(--tilt, 0deg));
    transition: transform 0.25s ease;
  }

  .project-card-wrapper:hover,
  .project-card-wrapper:focus-visible {
    transform: rotate(0deg) translateY(-5px) scale(1.01);
    z-index: 2;
  }

  /* Polaroid: even white frame, tiny roundover, soft paper-white gradient */
  .card {
    position: relative;
    background: linear-gradient(160deg, #ffffff 0%, #f7f5f0 100%);
    padding: 12px;
    border-radius: 3px;
    height: 100%;
    display: flex;
    flex-direction: column;
    box-shadow:
      0 1px 2px rgba(40, 30, 10, 0.28),
      0 12px 20px -6px rgba(40, 30, 10, 0.32);
    transition: box-shadow 0.25s ease;
  }

  .project-card-wrapper:hover .card,
  .project-card-wrapper:focus-visible .card {
    box-shadow:
      0 2px 3px rgba(40, 30, 10, 0.25),
      0 20px 30px -8px rgba(40, 30, 10, 0.38);
  }

  /* Glossy sheen across the whole card */
  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background:
      linear-gradient(115deg,
        rgba(255, 255, 255, 0) 22%,
        rgba(255, 255, 255, 0.38) 38%,
        rgba(255, 255, 255, 0.06) 52%,
        rgba(255, 255, 255, 0) 62%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0) 40%);
  }

  .card-img-container {
    position: relative;
    width: 100%;
    height: 190px;
    background: #ebe8e1;
    overflow: hidden;
  }

  /* hairline inside the photo edge, like a printed photo */
  .card-img-container::after {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.1);
    pointer-events: none;
  }

  .main-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .project-card-wrapper:hover .main-photo {
    transform: scale(1.03);
  }

  .photo-placeholder {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .placeholder-icon { font-size: 2.5rem; opacity: 0.35; }

  .card-body {
    padding: 1rem 0.4rem 0.35rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.7rem;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .card-year {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--muted);
  }

  /* highlighted (featured) projects get a small star on the All Work page */
  .card.featured .card-year::before {
    content: '★ ';
    color: var(--accent-text);
  }

  .tag-list { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .card-tag {
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--accent-text);
    background: rgba(46,89,67,0.08);
    padding: 0.15em 0.55em;
    border-radius: 4px;
  }

  .card-title {
    font-size: 1.15rem;
    font-weight: 600;
    margin: 0 0 0.5rem 0;
    line-height: 1.25;
    color: #1A1A1A;
    letter-spacing: -0.01em;
  }

  .card-desc {
    font-size: 0.93rem;
    line-height: 1.55;
    font-weight: 450;
    color: var(--muted);
    margin-bottom: 1.25rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    margin-top: auto;
    padding-top: 0.9rem;
    border-top: 1px solid rgba(60, 50, 30, 0.14);
  }

  .card-link {
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--accent-text);
  }

  .badge {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 5;
    background: #1A1A1A;
    color: #fff;
    padding: 0.2em 0.6em;
    font-size: 0.68rem;
    font-weight: 500;
    border-radius: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card-wrapper, .main-photo, .card { transition: none; }
  }
</style>
