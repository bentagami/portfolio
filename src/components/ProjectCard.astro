---
// 1. Ensure 'id' is in the props destructuring
const { title, year, tags, description, icon, id, badge, handtag, featured } = Astro.props;
---

<a href={`/work/${id}`} class="card-link">
  <div class={`project-card ${featured ? 'featured' : ''}`}>
    <div class="card-header">
      <div class="header-left">
        <span class="icon">{icon}</span>
        <span class="year">{year}</span>
      </div>
      {badge && <span class="badge">{badge}</span>}
    </div>

    <div class="card-body">
      <h3>{title}</h3>
      {handtag && <p class="handtag">{handtag}</p>}
      <p class="description">{description}</p>
    </div>

    <div class="card-footer">
      <div class="tags">
        {tags.map((tag: string) => <span class="tag">#{tag}</span>)}
      </div>
      <span class="arrow">→</span>
    </div>
  </div>
</a>

<style>
  /* 3. Add styling to ensure the link doesn't look like a blue hyperlink */
  .card-link {
    text-decoration: none;
    color: inherit;
    display: block;
    transition: transform 0.2s ease;
  }

  .card-link:hover {
    transform: translateY(-4px);
  }

  /* Your existing .project-card styles go here... */
</style>
