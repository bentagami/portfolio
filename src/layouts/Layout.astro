---
import '../styles/global.css';
import { getEntry } from 'astro:content';

const contactEntry = await getEntry('contact', 'index');
const socials = contactEntry?.data.socials || [];
const github = socials.find(s => s.platform.toLowerCase() === 'github');
const linkedin = socials.find(s => s.platform.toLowerCase() === 'linkedin');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ben Tagami | Portfolio</title>
  </head>
  <body>
    <nav>
      <div class="nav-inner">
        <div class="nav-left">
          <a href="/" class="wordmark">BEN TAGAMI</a>
        </div>
        <ul>
          <li><a href="/">Work</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>
    </nav>

    <slot /> <footer>
      <div class="footer-inner">
        <div class="footer-left">
          <span class="footer-wordmark">BEN TAGAMI</span>
          <span class="footer-copy">© {new Date().getFullYear()}</span>
        </div>
        <div class="footer-links">
          {github && <a href={github.url} target="_blank">GitHub</a>}
          {linkedin && <a href={linkedin.url} target="_blank">LinkedIn</a>}
          <a href="/contact">Contact</a>
        </div>
      </div>
    </footer>
  </body>
</html>
