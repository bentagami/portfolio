---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

const contactEntry = await getEntry('contact', 'index');
const contact = contactEntry?.data;
---

<Layout title="Contact">
  <section class="hero">
    <div class="hero-grid">
      <div class="hero-text">
        <h1>Get in <span class="hl-wrap"><span class="hl-text">touch</span></span></h1>
        
        <div class="specs" style="margin-top: 2rem;">
          <div class="spec-row">
            <span class="spec-label">Email</span>
            <span class="spec-val"><a href={`mailto:${contact?.email}`}>{contact?.email}</a></span>
          </div>
          
          {contact?.socials.map((s) => (
            <div class="spec-row">
              <span class="spec-label">{s.platform.toUpperCase()}</span>
              <span class="spec-val"><a href={s.url} target="_blank">{s.handle}</a></span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>
