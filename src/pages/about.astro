---
import Layout from '../layouts/Layout.astro';
import { getEntry, render } from 'astro:content';

const aboutEntry = await getEntry('about', 'index');
if (!aboutEntry) return Astro.redirect('/404');

const { Content } = await render(aboutEntry);
const photo = aboutEntry.data.photo;
---

<Layout title="About">
  <section class="hero about-hero">
    <div class="hero-grid">
      <div class="hero-text">
        <h1>{aboutEntry.data.title}</h1>
        <p class="hero-sub">{aboutEntry.data.subtitle}</p>
        
        <div class="about-content pro-text">
          <Content />
        </div>
      </div>

      {photo && (
        <div class="about-photo">
          <img src={photo} alt={aboutEntry.data.subtitle || 'Photo'} />
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  .about-hero .hero-grid { align-items: start; }
  .about-hero .hero-grid:has(.about-photo) { grid-template-columns: 1fr 300px; }
  .about-photo img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 12px;
    border: 1px solid #E5E3DE;
  }
  @media (max-width: 640px) {
    .about-hero .hero-grid:has(.about-photo) { grid-template-columns: 1fr; }
    .about-photo { order: -1; max-width: 240px; }
  }
  .about-content {
    margin-top: 2rem;
    line-height: 1.6;
    max-width: 600px;
    font-size: 1.1rem;
    color: #444;
  }
  /* Re-use the technical font styling */
  .pro-text :global(p) { margin-bottom: 1.5rem; }
</style>
