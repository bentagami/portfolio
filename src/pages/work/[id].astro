---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const allProjects = await getCollection('projects');
  // Sort them so "Next" follows your homepage order (by year)
  const sorted = allProjects.sort((a, b) => b.data.year - a.data.year);
  
  return sorted.map((project, index) => ({
    params: { id: project.id }, 
    props: { 
      project,
      // Pass the next project as a prop
      nextProject: sorted[index + 1] || sorted[0] // Loop back to start if at the end
    },
  }));
}

const { project, nextProject } = Astro.props;
const { Content } = await render(project);
const { title, year, icon, tags, description, badge, handtag } = project.data;
---

<Layout title={`${title} | Project Brief`}>
  <div class="brief-wrapper">
    <header class="brief-header">
      <div class="brief-meta">
        <div class="meta-item">
          <span class="label">LOG_ID:</span>
          <span class="value">REF_{project.id.toUpperCase()}</span>
        </div>
        <div class="meta-item">
          <span class="label">YEAR:</span>
          <span class="value">{year}</span>
        </div>
        {badge && <span class="status-badge">{badge}</span>}
      </div>

      <div class="title-block">
        <span class="project-icon">{icon}</span>
        <h1>{title}</h1>
      </div>

      {handtag && <p class="hand-note">“{handtag}”</p>}
      <p class="summary-text">{description}</p>

      <div class="tag-row">
        {tags.map(tag => <span class="tech-tag">#{tag}</span>)}
      </div>
    </header>

    <div class="divider">
      <div class="line"></div>
      <span class="divider-text">TECHNICAL_DOCUMENTATION</span>
    </div>

    <main class="brief-content">
      <Content />
    </main>

    <footer class="brief-footer">
      <div class="nav-controls">
        <a href="/" class="nav-btn secondary">
          <span class="btn-icon">⌂</span> 
          <span class="btn-text">RETURN_TO_INDEX</span>
        </a>

        <a href={`/work/${nextProject.id}`} class="nav-btn primary">
          <div class="next-label">NEXT_LOG_ENTRY →</div>
          <div class="next-title">{nextProject.data.title}</div>
        </a>
      </div>
    </footer>
  </div>
</Layout>

<style>
  /* ... (keep your previous .brief-wrapper and header styles) ... */

  .brief-footer {
    margin-top: 8rem;
    padding-top: 4rem;
    border-top: 1px solid #e2e8f0;
  }

  .nav-controls {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: stretch;
  }

  .nav-btn {
    text-decoration: none;
    padding: 1.5rem;
    border: 1px solid #e2e8f0;
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* "Back to Home" Button Styles */
  .nav-btn.secondary {
    align-items: center;
    background: #f8fafc;
    color: #64748b;
    font-family: monospace;
    font-size: 0.8rem;
  }

  /* "Next Project" Button Styles */
  .nav-btn.primary {
    background: #ffffff;
    border-color: #1B3D6E;
    color: #1B3D6E;
    text-align: right;
    position: relative;
    overflow: hidden;
  }

  .nav-btn.primary::after {
    content: "";
    position: absolute;
    right: 0; top: 0; bottom: 0;
    width: 4px;
    background: #1B3D6E;
  }

  .next-label {
    font-family: monospace;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    margin-bottom: 0.5rem;
    opacity: 0.7;
  }

  .next-title {
    font-weight: 800;
    font-size: 1.2rem;
  }

  /* Hover Effects */
  .nav-btn:hover {
    border-color: #1B3D6E;
    background: #f1f5f9;
    transform: translateY(-2px);
  }

  .nav-btn.primary:hover {
    background: #1B3D6E;
    color: white;
  }

  @media (max-width: 600px) {
    .nav-controls { grid-template-columns: 1fr; }
  }
</style>
