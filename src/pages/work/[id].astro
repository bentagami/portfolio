---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const allProjects = await getCollection('projects');
  const sorted = allProjects.sort((a, b) => b.data.year - a.data.year);
  
  return sorted.map((project, index) => ({
    params: { id: project.id }, 
    props: { 
      project,
      nextProject: sorted[index + 1] || sorted[0]
    },
  }));
}

const { project, nextProject } = Astro.props;
const { Content } = await render(project);
const { title, year, icon, tags, description, badge, handtag } = project.data;
---

<Layout title={`${title} | Project Brief`}>
  <div class="brief-wrapper">
    <header class="brief-header">
      <div class="brief-meta">
        <div class="meta-item">
          <span class="label">LOG_ID:</span>
          <span class="value">REF_{project.id.toUpperCase()}</span>
        </div>
        <div class="meta-item">
          <span class="label">YEAR:</span>
          <span class="value">{year}</span>
        </div>
        {badge && <span class="status-badge">{badge}</span>}
      </div>

      <div class="title-block">
        <span class="project-icon">{icon}</span>
        <h1>{title}</h1>
      </div>

      {handtag && <p class="hand-note">“{handtag}”</p>}
      <p class="summary-text">{description}</p>

      <div class="tag-row">
        {tags.map(tag => <span class="tech-tag">#{tag}</span>)}
      </div>
    </header>

    <div class="divider">
      <div class="line"></div>
      <span class="divider-text">TECHNICAL_DOCUMENTATION</span>
    </div>

    <main class="brief-content">
      <Content />
    </main>

    <footer class="brief-footer">
      <div class="nav-controls">
        <a href="/" class="nav-btn secondary">
          <span class="btn-icon">⌂</span> 
          <span class="btn-text">RETURN_TO_INDEX</span>
        </a>

        <a href={`/work/${nextProject.id}`} class="nav-btn primary">
          <div class="next-label">NEXT_LOG_ENTRY →</div>
          <div class="next-title">{nextProject.data.title}</div>
        </a>
      </div>
    </footer>
  </div>
</Layout>

<style>
  .brief-wrapper {
    max-width: 850px;
    margin: 5rem auto;
    padding: 0 2rem;
    font-family: ui-sans-serif, system-ui, sans-serif;
  }

  /* --- HEADER STYLING --- */
  .brief-header { margin-bottom: 3rem; }
  
  .brief-meta {
    display: flex;
    gap: 2rem;
    font-family: monospace;
    font-size: 0.75rem;
    color: #64748b;
    margin-bottom: 2rem;
    align-items: center;
  }

  .label { font-weight: bold; margin-right: 0.5rem; color: #1B3D6E; }
  
  .status-badge { 
    background: #1B3D6E; 
    color: white; 
    padding: 2px 8px; 
    text-transform: uppercase; 
    letter-spacing: 0.05em;
  }

  .title-block { display: flex; align-items: baseline; gap: 1rem; margin-bottom: 1rem; }
  .project-icon { font-size: 2.5rem; }
  
  h1 { 
    font-size: clamp(2.5rem, 5vw, 4rem); 
    font-weight: 800; 
    line-height: 0.9; 
    margin: 0; 
    color: #0f172a; 
    letter-spacing: -0.03em;
  }

  .hand-note { 
    font-family: 'Comic Sans MS', cursive; 
    color: #2563eb; 
    font-size: 1.1rem;
    transform: rotate(-1.5deg);
    margin: 1rem 0 2rem 0;
  }

  .summary-text { 
    font-size: 1.25rem; 
    line-height: 1.6; 
    color: #334155; 
    margin-bottom: 2rem; 
    max-width: 65ch; 
  }

  .tech-tag { 
    font-family: monospace; 
    font-size: 0.7rem; 
    color: #1B3D6E; 
    border: 1px solid #e2e8f0; 
    padding: 4px 10px; 
    margin-right: 0.5rem; 
  }

  /* --- DIVIDER --- */
  .divider { display: flex; align-items: center; gap: 1rem; margin: 4rem 0; }
  .line { flex-grow: 1; height: 1px; background: #cbd5e1; }
  .divider-text { font-family: monospace; font-size: 0.65rem; color: #94a3b8; letter-spacing: 0.2em; }

  /* --- TECHNICAL CONTENT STYLING (The Markdown) --- */
  .brief-content { 
    line-height: 1.8; 
    font-size: 1.1rem; 
    color: #1e293b; 
  }

  /* Subheaders */
  .brief-content :global(h2) { 
    font-family: monospace; 
    font-size: 1.4rem; 
    border-bottom: 2px solid #1B3D6E; 
    padding-bottom: 0.5rem; 
    margin-top: 4rem;
    margin-bottom: 1.5rem;
    color: #0f172a;
    display: table; /* Shrinks border to text width */
  }

  .brief-content :global(h3) {
    font-size: 1.2rem;
    font-weight: 700;
    margin-top: 2rem;
  }

  /* Paragraphs & Lists */
  .brief-content :global(p) { margin-bottom: 1.5rem; }

  .brief-content :global(ul) {
    padding-left: 1.25rem;
    margin-bottom: 2rem;
  }

  .brief-content :global(li) {
    margin-bottom: 0.5rem;
    list-style-type: "→ "; /* Technical arrow bullet */
    color: #334155;
  }

  /* Images in Content */
  .brief-content :global(img) { 
    width: 100%; 
    border: 1px solid #e2e8f0; 
    padding: 0.75rem;
    background: #ffffff;
    border-radius: 2px;
    margin: 3rem 0; 
    box-shadow: 0 10px 15px -3px rgba(0,0,0,0.05);
  }

  /* Code Blocks (if you use them) */
  .brief-content :global(pre) {
    background: #0f172a;
    padding: 1.5rem;
    border-radius: 4px;
    margin: 2rem 0;
    overflow-x: auto;
  }

  /* --- FOOTER / NAVIGATION --- */
  .brief-footer {
    margin-top: 8rem;
    padding-top: 4rem;
    border-top: 1px solid #e2e8f0;
  }

  .nav-controls {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .nav-btn {
    text-decoration: none;
    padding: 1.5rem;
    border: 1px solid #e2e8f0;
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .nav-btn.secondary {
    align-items: center;
    background: #f8fafc;
    color: #64748b;
    font-family: monospace;
    font-size: 0.8rem;
  }

  .nav-btn.primary {
    background: #ffffff;
    border-color: #1B3D6E;
    color: #1B3D6E;
    text-align: right;
    position: relative;
    overflow: hidden;
  }

  .nav-btn.primary::after {
    content: "";
    position: absolute;
    right: 0; top: 0; bottom: 0;
    width: 4px;
    background: #1B3D6E;
  }

  .next-label {
    font-family: monospace;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    margin-bottom: 0.5rem;
    opacity: 0.7;
  }

  .next-title { font-weight: 800; font-size: 1.2rem; }

  .nav-btn:hover {
    border-color: #1B3D6E;
    background: #f1f5f9;
    transform: translateY(-2px);
  }

  .nav-btn.primary:hover {
    background: #1B3D6E;
    color: white;
  }

  @media (max-width: 600px) {
    .nav-controls { grid-template-columns: 1fr; }
  }
</style>
