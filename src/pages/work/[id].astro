---
import Layout from '../../layouts/Layout.astro'; // Switched from Base to Layout
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const allProjects = await getCollection('projects');
  
  return allProjects.map(project => ({
    params: { id: project.id }, 
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const { 
  title, 
  year, 
  icon, 
  tags, 
  description, 
  badge, 
  handtag 
} = project.data;
---

<Layout title={`${title} — Project Log`}>
  <article class="project-container">
    <header class="project-header">
      <nav class="breadcrumb">
        <a href="/">INDEX</a> / <span class="current">{project.id.toUpperCase()}</span>
      </nav>

      <div class="meta-header">
        <div class="meta-left">
          <span class="status-indicator">●</span>
          <span class="id-badge">REF_{project.id.toUpperCase()}</span>
          <span class="year-stamp">[{year}]</span>
        </div>
        {badge && <div class="badge-tag">{badge}</div>}
      </div>

      <h1 class="project-title">
        <span class="title-icon">{icon}</span>
        {title}
      </h1>

      {handtag && <div class="hand-annotation">{handtag}</div>}
      
      <p class="project-summary">{description}</p>

      <div class="tag-cloud">
        {tags.map(tag => <span class="tech-tag">{tag}</span>)}
      </div>
    </header>

    <div class="blueprint-line"></div>

    <main class="project-prose">
      <Content />
    </main>

    <footer class="project-footer">
      <a href="/" class="back-link">
        <span class="arrow">←</span> BACK_TO_SYSTEM_INDEX
      </a>
    </footer>
  </article>
</Layout>

<style>
  :root {
    --tech-blue: #1B3D6E;
    --border-color: #e2e8f0;
  }

  .project-container {
    max-width: 800px;
    margin: 4rem auto;
    padding: 0 2rem;
    font-family: var(--font-sans, sans-serif);
  }

  /* Breadcrumbs */
  .breadcrumb {
    font-family: monospace;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    margin-bottom: 2rem;
    color: #94a3b8;
  }
  .breadcrumb a { color: inherit; text-decoration: none; }
  .breadcrumb a:hover { color: var(--tech-blue); }

  /* Meta Header */
  .meta-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: monospace;
    font-size: 0.8rem;
    margin-bottom: 1rem;
  }
  .status-indicator { color: #10b981; margin-right: 0.5rem; animation: pulse 2s infinite; }
  .id-badge { background: #f1f5f9; padding: 2px 8px; border-radius: 4px; font-weight: bold; }
  .year-stamp { margin-left: 1rem; color: #64748b; }

  /* Title & Summary */
  .project-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    line-height: 1;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .hand-annotation {
    font-family: 'Comic Sans MS', cursive; /* Or a handwritten font if you have one */
    color: #1e40af;
    transform: rotate(-2deg);
    margin-bottom: 1rem;
    font-size: 0.9rem;
  }
  .project-summary {
    font-size: 1.25rem;
    line-height: 1.6;
    color: #334155;
    margin-bottom: 2rem;
  }

  /* Technical Tags */
  .tag-cloud { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .tech-tag {
    font-family: monospace;
    font-size: 0.7rem;
    padding: 4px 10px;
    border: 1px solid var(--border-color);
    text-transform: uppercase;
  }

  .blueprint-line {
    height: 1px;
    background: linear-gradient(to right, var(--tech-blue), transparent);
    margin: 3rem 0;
  }

  /* Prose / Markdown Styling */
  .project-prose {
    line-height: 1.8;
    font-size: 1.1rem;
    color: #1e293b;
  }
  .project-prose :global(h2) {
    font-family: monospace;
    font-size: 1.5rem;
    margin: 3rem 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-color);
  }
  .project-prose :global(p) { margin-bottom: 1.5rem; }
  .project-prose :global(img) {
    width: 100%;
    border: 1px solid var(--border-color);
    margin: 2rem 0;
  }

  /* Footer */
  .project-footer { margin-top: 5rem; padding-top: 2rem; border-top: 1px solid var(--border-color); }
  .back-link {
    font-family: monospace;
    text-decoration: none;
    color: var(--tech-blue);
    font-weight: bold;
    font-size: 0.9rem;
  }

  @keyframes pulse {
    0% { opacity: 1; }
    50% { opacity: 0.4; }
    100% { opacity: 1; }
  }
</style>
