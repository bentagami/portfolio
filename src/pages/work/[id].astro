---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const allProjects = await getCollection('projects');
  return allProjects.map(project => ({
    params: { id: project.id }, 
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, year, icon, tags, description, badge, handtag } = project.data;
---

<Layout title={`${title} | Project Brief`}>
  <div class="brief-wrapper">
    <header class="brief-header">
      <div class="brief-meta">
        <div class="meta-item">
          <span class="label">LOG_ID:</span>
          <span class="value">REF_{project.id.toUpperCase()}</span>
        </div>
        <div class="meta-item">
          <span class="label">YEAR:</span>
          <span class="value">{year}</span>
        </div>
        {badge && <span class="status-badge">{badge}</span>}
      </div>

      <div class="title-block">
        <span class="project-icon">{icon}</span>
        <h1>{title}</h1>
      </div>

      {handtag && <p class="hand-note">“{handtag}”</p>}
      <p class="summary-text">{description}</p>

      <div class="tag-row">
        {tags.map(tag => <span class="tech-tag">#{tag}</span>)}
      </div>
    </header>

    <div class="divider">
      <div class="line"></div>
      <span class="divider-text">TECHNICAL_DOCUMENTATION</span>
    </div>

    <main class="brief-content">
      <Content />
    </main>

    <footer class="brief-footer">
      <a href="/" class="back-btn">
        <span class="arrow">←</span> RETURN TO TERMINAL_INDEX
      </a>
    </footer>
  </div>
</Layout>

<style>
  .brief-wrapper {
    max-width: 850px;
    margin: 5rem auto;
    padding: 0 2rem;
    font-family: var(--font-sans, sans-serif);
  }

  /* Meta styling */
  .brief-meta {
    display: flex;
    gap: 2rem;
    font-family: monospace;
    font-size: 0.75rem;
    color: #64748b;
    margin-bottom: 2rem;
    align-items: center;
  }
  .label { font-weight: bold; margin-right: 0.5rem; color: #1B3D6E; }
  .status-badge { 
    background: #1B3D6E; 
    color: white; 
    padding: 2px 8px; 
    text-transform: uppercase; 
    letter-spacing: 0.05em;
  }

  /* Title styling */
  .title-block { display: flex; align-items: baseline; gap: 1rem; margin-bottom: 1rem; }
  .project-icon { font-size: 2.5rem; }
  h1 { font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 800; line-height: 0.9; margin: 0; color: #0f172a; }

  .hand-note { 
    font-family: 'Comic Sans MS', cursive; /* Fallback for handwritten feel */
    color: #2563eb; 
    font-size: 1rem;
    transform: rotate(-1deg);
    margin-bottom: 1.5rem;
  }

  .summary-text { font-size: 1.25rem; line-height: 1.6; color: #334155; margin-bottom: 2rem; max-width: 65ch; }

  .tech-tag { font-family: monospace; font-size: 0.7rem; color: #1B3D6E; border: 1px solid #e2e8f0; padding: 4px 10px; margin-right: 0.5rem; }

  /* Blueprint Divider */
  .divider { display: flex; align-items: center; gap: 1rem; margin: 4rem 0; }
  .line { flex-grow: 1; height: 1px; background: #cbd5e1; }
  .divider-text { font-family: monospace; font-size: 0.65rem; color: #94a3b8; letter-spacing: 0.2em; }

  /* Markdown Body Content Styling */
  .brief-content { line-height: 1.8; font-size: 1.1rem; color: #1e293b; }
  .brief-content :global(h2) { font-family: monospace; font-size: 1.5rem; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.5rem; margin-top: 3rem; }
  .brief-content :global(p) { margin-bottom: 1.5rem; }
  .brief-content :global(img) { width: 100%; border-radius: 4px; border: 1px solid #e2e8f0; margin: 2rem 0; }

  /* Footer */
  .brief-footer { margin-top: 6rem; padding-top: 2rem; border-top: 1px dashed #cbd5e1; }
  .back-btn { font-family: monospace; font-size: 0.85rem; color: #1B3D6E; text-decoration: none; font-weight: bold; }
  .back-btn:hover { text-decoration: underline; }
</style>
