---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const allProjects = await getCollection('projects');
  const sorted = allProjects.sort((a, b) => b.data.year - a.data.year);
  
  return sorted.map((project, index) => ({
    params: { id: project.id }, 
    props: { 
      project,
      nextProject: sorted[index + 1] || sorted[0]
    },
  }));
}

const { project, nextProject } = Astro.props;
const { Content } = await render(project);
const { title, year, icon, tags, description, badge } = project.data;
---

<Layout title={`${title} | Project`}>
  <div class="brief-wrapper">
    <header class="brief-header">
      <div class="brief-meta">
        <span class="value">{year}</span>
        {badge && <span class="status-badge">{badge}</span>}
      </div>

      <div class="title-block">
        {icon && <span class="project-icon">{icon}</span>}
        <h1>{title}</h1>
      </div>

      <p class="summary-text">{description}</p>

      <div class="tag-row">
        {tags.map(tag => <span class="tech-tag">{tag}</span>)}
      </div>
    </header>

    <main class="brief-content">
      <Content />
    </main>

    <footer class="brief-footer">
      <div class="nav-controls">
        <a href="/" class="nav-btn secondary">
          <span class="btn-text">← All projects</span>
        </a>

        <a href={`/work/${nextProject.id}`} class="nav-btn primary">
          <div class="next-label">Next project</div>
          <div class="next-title">{nextProject.data.title}</div>
        </a>
      </div>
    </footer>
  </div>
</Layout>

<style>
  .brief-wrapper {
    max-width: 780px;
    margin: 3.5rem auto;
    padding: 0 2rem;
  }

  .brief-header { margin-bottom: 2.5rem; }

  .brief-meta {
    display: flex;
    gap: 1rem;
    align-items: center;
    font-size: 0.85rem;
    color: #6B6B6B;
    margin-bottom: 1.25rem;
  }

  .status-badge {
    background: #1A1A1A;
    color: white;
    padding: 0.2em 0.6em;
    border-radius: 4px;
    font-size: 0.72rem;
    font-weight: 500;
  }

  .title-block { display: flex; align-items: baseline; gap: 0.75rem; margin-bottom: 1rem; }
  .project-icon { font-size: 2rem; }

  h1 {
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 700;
    line-height: 1.1;
    margin: 0;
    color: #1A1A1A;
    letter-spacing: -0.02em;
  }

  .summary-text {
    font-size: 1.15rem;
    line-height: 1.65;
    color: #444;
    margin-bottom: 1.5rem;
    max-width: 65ch;
  }

  .tag-row { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .tech-tag {
    font-size: 0.75rem;
    color: #2E5943;
    background: rgba(46,89,67,0.08);
    border-radius: 4px;
    padding: 0.25em 0.65em;
  }

  /* Markdown content styling */
  .brief-content {
    line-height: 1.75;
    font-size: 1.05rem;
    color: #1e293b;
  }

  .brief-content :global(h2) {
    font-size: 1.35rem;
    font-weight: 700;
    margin-top: 2.75rem;
    margin-bottom: 1.1rem;
    color: #1A1A1A;
  }

  .brief-content :global(h3) {
    font-size: 1.1rem;
    font-weight: 600;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
  }

  .brief-content :global(p) { margin-bottom: 1.35rem; }

  .brief-content :global(ul) {
    padding-left: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .brief-content :global(li) { margin-bottom: 0.4rem; }

  .brief-content :global(img) {
    width: 100%;
    border-radius: 8px;
    margin: 2rem 0;
  }

  .brief-content :global(pre) {
    background: #1A1A1A;
    color: #fff;
    padding: 1.25rem;
    border-radius: 8px;
    margin: 1.5rem 0;
    overflow-x: auto;
  }

  /* Footer nav */
  .brief-footer {
    margin-top: 4rem;
    padding-top: 2.5rem;
    border-top: 1px solid #E5E3DE;
  }

  .nav-controls {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .nav-btn {
    text-decoration: none;
    padding: 1.25rem;
    border: 1px solid #E5E3DE;
    border-radius: 8px;
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .nav-btn.secondary {
    align-items: flex-start;
    color: #6B6B6B;
    font-size: 0.9rem;
  }

  .nav-btn.primary {
    background: #fff;
    color: #1A1A1A;
    text-align: right;
  }

  .next-label {
    font-size: 0.78rem;
    color: #6B6B6B;
    margin-bottom: 0.35rem;
  }

  .next-title { font-weight: 600; font-size: 1.05rem; }

  .nav-btn:hover {
    border-color: #2E5943;
    background: rgba(46,89,67,0.04);
  }

  @media (max-width: 600px) {
    .nav-controls { grid-template-columns: 1fr; }
  }
</style>
