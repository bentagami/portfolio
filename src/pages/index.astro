---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection, getEntry } from 'astro:content';

// 1. Fetch the data
// 'homepage' is the collection, 'index' is the filename (index.md)
const homeEntry = await getEntry('homepage', 'index');
const projectCollection = await getCollection('projects');

// 2. Fallback logic so the site doesn't crash if the loader fails
const home = homeEntry?.data || {
  headline: "DATA LINK ERROR",
  highlight: "ERROR",
  subheadline: `Astro 6 found ${projectCollection.length} projects.`,
  tagline: "The homepage loader is pointing to the wrong place.",
  sticky_note: "Check Loader Base Path",
  specs: []
};

const projects = projectCollection.sort((a, b) => b.data.year - a.data.year);
const headline = home.headline || "";
const highlight = home.highlight || "";
const parts = headline.includes(highlight) ? headline.split(highlight) : [headline, ""];
---

<Layout>
  <h1>{parts[0]} <span class="hl">{highlight}</span> {parts[1]}</h1>
</Layout>
