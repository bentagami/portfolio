---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

// This is the modern, safe way to fetch your projects
const projects = await getCollection('projects'); 
---

<Layout>
  <section class="hero">
    <div class="sticky">
      <div class="tape"></div>
      update<br>copy here ✏️<br>& add photo
    </div>

    <div class="hero-grid">
      <div class="hero-text">
        <h1>
          HI, I'M BEN.<br>
          I <span class="hl-wrap"><div class="hl"></div><span class="hl-text">MAKE</span></span><br>
          THINGS.
        </h1>

        <svg class="name-line" viewBox="0 0 280 6" xmlns="http://www.w3.org/2000/svg">
          <path d="M0 3 Q20 1 40 4 Q70 6 100 2 Q140 0 180 3 Q210 5 250 2 Q265 1 280 3" fill="none" stroke="#1B3D6E" stroke-width="1.8" stroke-linecap="round"/>
        </svg>

        <p class="hero-sub">Engineer — Builder — Prototyper</p>

        <p class="tagline">I build across the full stack — PCB layouts, firmware, mechanical assemblies, web apps. If it can be made, I'll make it work.</p>

        <div class="specs">
          <div class="spec-row"><span class="spec-label">Discipline</span><span class="spec-val">Full-Stack Eng.</span></div>
          <div class="spec-row"><span class="spec-label">Speciality</span><span class="spec-val">HW + SW Systems</span></div>
          <div class="spec-row"><span class="spec-label">Location</span><span class="spec-val">San Francisco</span></div>
          <div class="spec-row"><span class="spec-label">Background</span><span class="spec-val">Maker / Builder</span></div>
        </div>
      </div>

      <div class="photo-col">
        <div class="photo-tape"></div>
        <div class="photo-slot">
          <div class="photo-placeholder">
            <span class="icon">🧑‍💻</span>
          </div>
        </div>
        <div class="photo-note">← that's me</div>
      </div>
    </div>
  </section>

  <div class="section-header">
    <div class="section-header-inner">
      <span class="section-num">01</span>
      <span class="section-title">Selected Work</span>
      <span class="section-count">{projects.length} PROJECTS LOGGED</span>
    </div>
  </div>

  <div class="grid">
    {projects.map((project) => (
      <ProjectCard 
        title={project.data.title}
        year={project.data.year}
        tags={project.data.tags}
        description={project.data.description}
        icon={project.data.icon}
        id={project.data.id}
        badge={project.data.badge}
        handtag={project.data.handtag}
        featured={project.data.featured}
      />
    ))}
  </div>
</Layout>
