---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection, getEntry } from 'astro:content';

// 1. Fetch Homepage Data from src/content/homepage/index.md
const homeEntry = await getEntry('homepage', 'index');

// Safety check: if the file is missing, provide fallback data to prevent a crash
const home = homeEntry ? homeEntry.data : {
  headline: "HI, I'M BEN. I MAKE THINGS.",
  highlight: "MAKE",
  subheadline: "Engineer — Builder",
  tagline: "Loading bio...",
  sticky_note: "Sticky note loading...",
  specs: []
};

// 2. Fetch and Sort Projects from src/content/projects/*.md
const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => b.data.year - a.data.year);

// 3. Logic to handle the headline highlighting
const parts = home.headline.split(home.highlight);
---

<Layout>
  <section class="hero">
    <div class="sticky">
      <div class="tape"></div>
      {home.sticky_note}
    </div>

    <div class="hero-grid">
      <div class="hero-text">
        <h1>
          {parts[0]}
          <span class="hl-wrap">
            <div class="hl"></div>
            <span class="hl-text">{home.highlight}</span>
          </span>
          {parts[1]}
        </h1>

        <svg class="name-line" viewBox="0 0 280 6" xmlns="http://www.w3.org/2000/svg">
          <path d="M0 3 Q20 1 40 4 Q70 6 100 2 Q140 0 180 3 Q210 5 250 2 Q265 1 280 3" fill="none" stroke="#1B3D6E" stroke-width="1.8" stroke-linecap="round"/>
        </svg>

        <p class="hero-sub">{home.subheadline}</p>

        <p class="tagline">{home.tagline}</p>

        <div class="specs">
          {home.specs && home.specs.map((spec) => (
            <div class="spec-row">
              <span class="spec-label">{spec.label}</span>
              <span class="spec-val">{spec.value}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="photo-col">
        <div class="photo-tape"></div>
        <div class="photo-slot">
          <div class="photo-placeholder">
            <span class="icon">🧑‍💻</span>
          </div>
        </div>
        <div class="photo-note">← that's me</div>
      </div>
    </div>
  </section>

  <div class="section-header">
    <div class="section-header-inner">
      <span class="section-num">01</span>
      <span class="section-title">Selected Work</span>
      <span class="section-count">{projects.length} PROJECTS LOGGED</span>
    </div>
  </div>

  <div class="grid">
    {projects.map((project) => (
      <ProjectCard 
        title={project.data.title}
        year={project.data.year}
        tags={project.data.tags}
        description={project.data.description}
        icon={project.data.icon}
        id={project.data.id}
        badge={project.data.badge}
        handtag={project.data.handtag}
        featured={project.data.featured}
      />
    ))}
  </div>
</Layout>
