---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection, getEntry } from 'astro:content';

// 1. Fetch the Homepage data (the ID is the filename 'index')
const homeEntry = await getEntry('homepage', 'index');

// 2. Fetch and Sort Projects
const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => b.data.year - a.data.year);

// 3. Extract Data with defaults if the file is missing
const home = homeEntry?.data || {
  mission_id: "MISSION: BT-001",
  headline: "HI, I'M BEN. I MAKE THINGS.",
  highlight: "MAKE",
  subheadline: "Engineer — Builder — Prototyper",
  tagline: "I build across the full stack.",
  sticky_note: "Content not found in src/content/homepage/index.md",
  specs: []
};

// 4. Headline Logic
const headline = home.headline || "";
const highlight = home.highlight || "";
const parts = headline.includes(highlight) 
  ? headline.split(highlight) 
  : [headline, ""];
---

<Layout>
  <section class="hero">
    <div class="hero-grid">
      <div class="hero-text">
        <h1>
          {parts[0]}
          <span class="hl-wrap">
            <span class="hl-text">{highlight}</span>
          </span>
          {parts[1]}
        </h1>

        <p class="hero-sub">{home.subheadline}</p>
        <p class="tagline">{home.tagline}</p>

        <div class="specs">
          {home.specs && home.specs.map((spec) => (
            <div class="spec-row">
              <span class="spec-label">{spec.label}</span>
              <span class="spec-val">{spec.value}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="photo-col">
        <div class="photo-slot">
          <div class="photo-placeholder">
            <span class="icon">🧑‍💻</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="section-header">
    <div class="section-header-inner">
      <span class="section-title">Selected Work</span>
      <span class="section-count">{projects.length} projects</span>
    </div>
  </div>

  <div class="grid">
    {projects.length > 0 ? (
      projects.map((project) => (
        <ProjectCard 
          title={project.data.title}
          year={project.data.year}
          tags={project.data.tags}
          description={project.data.description}
          coverImage={project.data.coverImage}
          icon={project.data.icon}
          id={project.id}
          badge={project.data.badge}
          handtag={project.data.handtag}
          featured={project.data.featured}
        />
      ))
    ) : (
      <div class="no-projects">No projects found in src/content/projects/</div>
    )}
  </div>
</Layout>
